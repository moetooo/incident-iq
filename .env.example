# IncidentIQ environment configuration.
#
# Copy this file to `.env` and adjust the values. Never commit `.env`.
# Every variable below is optional: the stack starts without a Gemini API key
# and the backend falls back to the deterministic analysis engine.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Inside Docker Compose the database is reachable as `db`.
DATABASE_URL=postgresql+psycopg://incidentiq:incidentiq@db:5432/incidentiq
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=incidentiq
POSTGRES_DB=incidentiq

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Base URL of the simulator service as seen from the backend container.
SIMULATOR_BASE_URL=http://simulator:8001
SIMULATOR_TIMEOUT_SECONDS=10

# Optional service authentication. When set, every /api/v1 request must send
# the header `X-API-Key: <value>`.
API_KEY=

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
ENVIRONMENT=development

# ---------------------------------------------------------------------------
# LLM provider (Gemini)
# ---------------------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey and keep it local.
# The key is read by the backend only and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45

# Gemini model discovery and fallback (optional)
# How long the discovered model listing is cached, in seconds.
GEMINI_MODEL_DISCOVERY_TTL_SECONDS=3600
# Maximum number of Gemini models to attempt before falling back to
# the deterministic analysis engine.
GEMINI_MAX_FALLBACK_ATTEMPTS=3
# Time budget, in seconds, for the fallback attempt sequence.
GEMINI_FALLBACK_TIME_BUDGET_SECONDS=30

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Base URL of the backend as seen from the browser. The frontend appends
# `/api/v1/...` to this value itself.
VITE_API_BASE_URL=http://localhost:8000

# Vite server-side proxy target (Docker Compose uses the backend service name).
VITE_DEV_PROXY_TARGET=http://backend:8000