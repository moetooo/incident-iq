# IncidentIQ Frontend Environment Variables
# Base URL for IncidentIQ Backend API (browser-facing origin)
VITE_API_BASE_URL=http://localhost:8000
# Dedicated Vite dev server proxy target (default: http://localhost:8000, in Docker Compose: http://backend:8000)
VITE_DEV_PROXY_TARGET=http://localhost:8000
# Default Operator ID for remediation authorization (non-secret local-demo default)
VITE_OPERATOR_ID=operator
